{
  "name": "@cringe-court/chain-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed CringeCourt bindings, the ChainPort interface, a viem adapter and an in-memory mock with the same semantics",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.57.15"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
