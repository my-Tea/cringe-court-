# Court AI configuration (server-side / developer machine only).
# Copy to the repo root as .env.court (git-ignored) and fill in.
#   Copy-Item packages/ai/.env.court.example .env.court
# NEVER prefix these with VITE_: Vite would bundle them into the browser.

# mock = offline template writer (default). 0g = real 0G Router inference (spends credits).
COURT_AI_PROVIDER=0g

# API key (sk-...) from https://pc.0g.ai -> API Keys. A management key (mk-...) cannot run inference.
OG_API_KEY=

# A chat model id from the live catalog: npm run court:test -- --list-models
# (No default on purpose: the catalog changes; pick one that lists json-mode.)
OG_MODEL=

# Optional. Mainnet default shown. Testnet uses a different URL and separate keys.
# OG_BASE_URL=https://router-api.0g.ai/v1

# Optional. standard (default) | verified | private. See docs/ai/10 §5.
# OG_TRUST_MODE=standard

# Optional tuning.
# OG_TIMEOUT_MS=45000
# OG_MAX_RETRIES=2
# OG_JSON_MODE=auto
