{
  "name": "@cringe-court/audio",
  "version": "0.0.0",
  "private": true,
  "description": "Procedural Web Audio sound design for CringeCourt: typed cues, buses, ambience and case-event mapping. No audio files needed at runtime.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "render": "tsx scripts/render.ts",
    "render:check": "tsx scripts/render.ts --check",
    "demo": "vite demo",
    "demo:build": "vite build demo --outDir ../dist-demo --emptyOutDir",
    "browser-check": "tsx scripts/browser-check.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "node-web-audio-api": "^2.2.0",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
