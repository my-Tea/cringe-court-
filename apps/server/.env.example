# apps/server configuration (all optional). See docs/BACKEND.md.
PORT=8787
HOST=127.0.0.1
# file (JSON-lines in CC_DATA_DIR) | memory (nothing kept)
CC_STORE=file
CC_DATA_DIR=.data/court-server
# Comma-separated web origins allowed to call the server; * allows any.
CC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HMAC key for signed invite links. Unset: generated once into CC_DATA_DIR/secret.key.
CC_SECRET=
# on | off: may visitors move the shared court clock forward (demo control)?
CC_DEMO_CLOCK=on
# late | fill | off: simulated Grand Jury jurors (late = humans get first pick)
CC_GJ_NPC_JURORS=late
CC_MAX_SESSIONS=5000
CC_MAX_VERSUS_CASES=500
CC_MAX_FACTS=50000
# on: trust X-Forwarded-For for rate limits (only behind your own proxy)
CC_TRUST_PROXY=off
