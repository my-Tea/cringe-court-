# Copy to apps/web/.env.local and fill in what you need. Every value is optional:
# with nothing set, the app runs the in-browser demo (testnet money only).

# Shared court server (apps/server) so Versus and Grand Jury work across devices.
# Unset: every court lives in this browser only. `npm run dev:full` sets it for you.
VITE_BACKEND_URL=

# Ledger: demo | arc-testnet (arc-testnet needs the three addresses below)
VITE_LEDGER=demo
VITE_ARC_RPC_URL=
VITE_ARC_COURT=
VITE_ARC_USDC=
VITE_ARC_REGISTRY=

# Identity: mock | world-idkit (world-idkit needs both values below)
VITE_IDENTITY=mock
VITE_WORLD_APP_ID=
VITE_WORLD_BACKEND_URL=
